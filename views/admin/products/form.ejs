<header class="page-head">
  <div>
    <p class="eyebrow"><a href="/admin/urunler">Ürünler</a></p>
    <h1><%= isNew ? 'Yeni ürün' : product.name || 'Ürünü düzenle' %></h1>
  </div>
  <% if (!isNew && product.slug && product.is_active) { %>
    <div class="page-head__actions">
      <a class="btn btn--ghost" href="/urun/<%= product.slug %>" target="_blank" rel="noopener">Sitede gör ↗</a>
    </div>
  <% } %>
</header>

<%- include('../partials/errors') %>

<form action="<%= isNew ? '/admin/urunler' : '/admin/urunler/' + product.id + '?_method=PUT' %>"
      method="post" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card">
    <h2 class="card__title">Temel bilgiler</h2>
    <div class="form-grid">
      <div class="field field--full">
        <label for="name">Ürün adı *</label>
        <input type="text" id="name" name="name" value="<%= product.name || '' %>" maxlength="150" required>
      </div>

      <div class="field">
        <label for="category_id">Kategori</label>
        <select id="category_id" name="category_id">
          <option value="">Kategorisiz</option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= String(product.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="field">
        <label for="price">Fiyat</label>
        <div class="input-group">
          <input type="text" id="price" name="price" inputmode="decimal" placeholder="145,50"
                 value="<%= product.price === null || product.price === undefined ? '' : product.price %>">
          <label class="sr-only" for="unit">Birim</label>
          <select id="unit" name="unit">
            <% units.forEach(function (u) { %>
              <option value="<%= u %>" <%= (product.unit || 'kg') === u ? 'selected' : '' %>><%= u %></option>
            <% }); %>
          </select>
        </div>
        <p class="hint">Boş bırakırsanız sitede "Fiyat için arayınız" yazar.</p>
      </div>

      <div class="field">
        <label for="origin">Yöre / menşe</label>
        <input type="text" id="origin" name="origin" value="<%= product.origin || '' %>" maxlength="120"
               placeholder="Ezine, Çanakkale">
        <p class="hint">Ürün sayfasında gösterilir. Bilinmiyorsa boş bırakın.</p>
      </div>

      <div class="field field--full">
        <label for="short_desc">Kısa açıklama</label>
        <input type="text" id="short_desc" name="short_desc" value="<%= product.short_desc || '' %>" maxlength="300">
        <p class="hint">Ürün kartında görünür.</p>
      </div>

      <div class="field field--full">
        <label for="description">Açıklama</label>
        <textarea id="description" name="description" rows="6"><%= product.description || '' %></textarea>
        <p class="hint">Paragrafları boş bir satırla ayırın.</p>
      </div>
    </div>
  </section>

  <section class="card">
    <h2 class="card__title">Görsel</h2>
    <%- include('../partials/image-field', { record: product }) %>
  </section>

  <section class="card">
    <h2 class="card__title">Yayın</h2>
    <div class="form-grid">
      <div class="field field--full">
        <label for="slug">Adres (slug)</label>
        <div class="input-group">
          <span class="input-group__prefix">/urun/</span>
          <input type="text" id="slug" name="slug" value="<%= product.slug || '' %>" maxlength="180"
                 placeholder="<%= isNew ? 'ürün adından üretilir' : '' %>">
        </div>
        <p class="hint">
          Boş bırakırsanız ürün adından üretilir. <strong>Dolu bırakırsanız ürün adını
          değiştirseniz bile adres sabit kalır</strong> — daha önce paylaşılan linkler kırılmaz.
        </p>
      </div>

      <div class="field">
        <label for="sort_order">Sıra</label>
        <input type="number" id="sort_order" name="sort_order" value="<%= product.sort_order || 0 %>">
        <p class="hint">Küçük sayı önce gösterilir. Listedeki ↑ ↓ tuşlarıyla da değiştirebilirsiniz.</p>
      </div>
      <div class="field checks">
        <label class="check">
          <input type="checkbox" name="is_active" value="1" <%= product.is_active ? 'checked' : '' %>>
          Sitede göster
        </label>
        <label class="check">
          <input type="checkbox" name="is_featured" value="1" <%= product.is_featured ? 'checked' : '' %>>
          Ana sayfada öne çıkar
        </label>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <button class="btn btn--primary" type="submit"><%= isNew ? 'Ekle' : 'Kaydet' %></button>
    <a class="btn btn--ghost" href="/admin/urunler">Vazgeç</a>
  </div>
</form>
