<article class="product-card">
  <a class="product-card__media" href="/urun/<%= product.slug %>" tabindex="-1" aria-hidden="true">
    <img src="<%= imageSrc(product.image) %>" alt="" loading="lazy">
  </a>
  <div class="product-card__body">
    <% if (product.category_name) { %><p class="label"><%= product.category_name %></p><% } %>
    <h3 class="product-card__title"><a href="/urun/<%= product.slug %>"><%= product.name %></a></h3>
    <% if (product.short_desc) { %><p class="product-card__desc"><%= product.short_desc %></p><% } %>
    <% const contactOnly = product.category_slug === 'sandvic'; %>
    <% const withPrice = showPrices && !contactOnly; %>
    <div class="product-card__foot<%= withPrice ? '' : ' product-card__foot--no-price' %>">
      <% if (withPrice) { %>
        <span class="product-card__price"><%= formatPrice(product.price, product.unit) %></span>
      <% } %>
      <a class="product-card__order" href="<%= waLink('Merhaba, ' + product.name + ' sipariş vermek istiyorum.') %>" target="_blank" rel="noopener"><%= contactOnly ? 'Fiyat ve sipariş için iletişime geçin' : 'Sipariş ver' %> <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
