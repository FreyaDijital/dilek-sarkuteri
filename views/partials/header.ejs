<%
  const navItems = [
    ['/hakkimizda', 'Hakkımızda'],
    ['/urunler', 'Ürünler'],
    ['/tabaklar', 'Tabaklar'],
    ['/iletisim', 'İletişim'],
  ];
  const isActive = (href) =>
    currentPath === href || currentPath.startsWith(href + '/') ||
    (href === '/urunler' && currentPath.startsWith('/urun/')) ||
    (href === '/tabaklar' && currentPath.startsWith('/kampanyalar'));
%>
<a class="skip-link" href="#icerik">İçeriğe geç</a>

<div class="progress" aria-hidden="true"><div class="progress__bar" data-progress></div></div>

<header class="site-nav" data-nav>
  <a class="site-nav__brand" href="/">
    <%# locals.* kullanımı bilinçli: middleware çalışmadığı bir render yolunda
        çıplak değişken ReferenceError atar ve asıl hatayı gizler. %>
    <img class="site-nav__logo" src="/img/logo.png" alt="Dilek Şarküteri">
    
  </a>

  <nav class="site-nav__menu" id="site-menu" aria-label="Ana menü">
    <% navItems.forEach(function ([href, label]) { %>
      <a class="site-nav__link" href="<%= href %>"<% if (isActive(href)) { %> aria-current="page"<% } %>><%= label %></a>
    <% }); %>
  </nav>

  <a class="btn btn--red btn--sm site-nav__cta" href="<%= waLink('Merhaba, sipariş vermek istiyorum.') %>" target="_blank" rel="noopener">
    <svg class="icon-wa" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.82c2.16 0 4.19.84 5.72 2.37a8.03 8.03 0 0 1 2.37 5.72c0 4.46-3.63 8.09-8.09 8.09a8.1 8.1 0 0 1-4.12-1.13l-.3-.18-3.06.8.82-2.99-.19-.31a8.04 8.04 0 0 1-1.23-4.29c0-4.46 3.63-8.08 8.08-8.08Zm-3.12 4.3c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.37-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.79-.19-.46-.39-.4-.54-.41h-.46Z"/>
    </svg>
    Sipariş ver
  </a>

  <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-nav-toggle>
    <span class="sr-only">Menüyü aç</span>
    <span class="site-nav__bars" aria-hidden="true"></span>
  </button>
</header>
