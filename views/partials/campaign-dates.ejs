<% if (campaign.starts_at || campaign.ends_at) { %>
  <p class="campaign-dates">
    <% if (campaign.starts_at && campaign.ends_at) { %>
      <time datetime="<%= campaign.starts_at %>"><%= formatDate(campaign.starts_at) %></time> –
      <time datetime="<%= campaign.ends_at %>"><%= formatDate(campaign.ends_at) %></time>
    <% } else if (campaign.ends_at) { %>
      Son gün: <time datetime="<%= campaign.ends_at %>"><%= formatDate(campaign.ends_at) %></time>
    <% } else { %>
      Başlangıç: <time datetime="<%= campaign.starts_at %>"><%= formatDate(campaign.starts_at) %></time>
    <% } %>
  </p>
<% } %>
