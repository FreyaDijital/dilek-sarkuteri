<% if (campaign.starts_at || campaign.ends_at) { %>
  <p class="campaign-dates">
    <% if (campaign.starts_at && campaign.ends_at) { %>
      <time datetime="<%= campaign.starts_at %>"><%= formatDateShort(campaign.starts_at) %></time>
      <span aria-hidden="true">–</span>
      <time datetime="<%= campaign.ends_at %>"><%= formatDateShort(campaign.ends_at) %></time>
    <% } else if (campaign.ends_at) { %>
      Son gün: <time datetime="<%= campaign.ends_at %>"><%= formatDateShort(campaign.ends_at) %></time>
    <% } else { %>
      <time datetime="<%= campaign.starts_at %>"><%= formatDateShort(campaign.starts_at) %></time>'den itibaren
    <% } %>
  </p>
<% } %>
