<%# Kampanya tarihleri, yıl her zaman açık: "12 Ekim – 30 Ekim 2026" %>
<% if (campaign.starts_at || campaign.ends_at) { %>
  <p class="campaign-dates">
    <% if (campaign.starts_at && campaign.ends_at) { %>
      <time datetime="<%= campaign.starts_at %>"><%= formatDateLong(campaign.starts_at, { year: !sameYear(campaign.starts_at, campaign.ends_at) }) %></time>
      <span aria-hidden="true">–</span>
      <time datetime="<%= campaign.ends_at %>"><%= formatDateLong(campaign.ends_at) %></time>
    <% } else if (campaign.ends_at) { %>
      Son gün: <time datetime="<%= campaign.ends_at %>"><%= formatDateLong(campaign.ends_at) %></time>
    <% } else { %>
      Başlangıç: <time datetime="<%= campaign.starts_at %>"><%= formatDateLong(campaign.starts_at) %></time>
    <% } %>
  </p>
<% } %>
