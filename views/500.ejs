<section class="error-page">
  <h1><%= title %></h1>

  <% if (typeof message !== 'undefined' && message) { %>
    <p><%= message %></p>
  <% } else { %>
    <p>Sorun kaydedildi, lütfen daha sonra tekrar deneyin.</p>
  <% } %>

  <% if (typeof detail !== 'undefined' && detail) { %>
    <pre><%= detail %></pre>
  <% } %>

  <p><a class="btn btn--red" href="/">Ana sayfaya dön</a></p>
</section>
