# ---- Uygulama ----
NODE_ENV=production
PORT=3000
# Site adresi (canonical URL, mutlak link üretiminde kullanılır)
SITE_URL=https://dileksarkuteri.com

# ---- Veritabanı (SQLite / better-sqlite3) ----
# Veritabanı dosyasının yolu. Varsayılan: ./data/dilek.db
# DİKKAT: Hostinger'da her deploy'da uygulama klasörü silinir. Verinin
# kalıcı olması için bu yolu da UPLOAD_DIR gibi uygulama dışına alın,
# örn: /home/KULLANICI/data/dilek.db
DB_PATH=./data/dilek.db

# ---- Oturum ----
# Uzun ve rastgele bir değer olmalı: openssl rand -hex 32
SESSION_SECRET=
# Oturum süresi (milisaniye) - varsayılan 8 saat
SESSION_MAX_AGE=28800000
# HTTPS üzerinden çalışıyorsa true
SESSION_SECURE=true

# ---- Görsel yükleme ----
# ÖNEMLİ: Hostinger'da her deploy'da uygulama klasörü silindiği için
# bu yol UYGULAMA KLASÖRÜNÜN DIŞINDA olmalı.
# Örn: /home/KULLANICI/uploads/dilek-sarkuteri
UPLOAD_DIR=/home/user/uploads/dilek-sarkuteri
# Yüklenen görsellerin web'de sunulacağı yol
UPLOAD_URL_PATH=/uploads
# Maksimum dosya boyutu (byte) - varsayılan 5 MB
UPLOAD_MAX_SIZE=5242880
